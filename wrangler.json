{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glide-chat-realtime",
  "main": "realtime/index.ts",
  "compatibility_date": "2026-06-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "Chat",
        "class_name": "Chat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}